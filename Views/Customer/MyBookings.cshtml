@model List<FribergCars.Models.Booking>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Bookings";
}

<h2>My Bookings</h2>

@if (TempData["BookingSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["BookingSuccess"]
    </div>
}


@if (!Model.Any())
{
    <p>You have no bookings yet.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Car</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Car.Brand @booking.Car.Model</td>
                    <td>@booking.StartDate.ToShortDateString()</td>
                    <td>@booking.EndDate.ToShortDateString()</td>
                    <td>
                        <form asp-action="DeleteBooking" asp-controller="Customer" asp-route-id="@booking.Id" method="post">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @section Scripts {
        <script>
            setTimeout(() => document.querySelector('.alert')?.remove(), 5000);
        </script>
    }

}

